rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 2 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLoginKey(id) {
      return id is string && id.size() >= 2 && id.size() <= 256 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEnvironmentOwner() {
      return isSignedIn() &&
        request.auth.token.email == 'jovanni.ayman@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function hasActiveSession() {
      return isSignedIn() && exists(/databases/$(database)/documents/activeSessions/$(request.auth.uid));
    }

    function activeSessionData() {
      return get(/databases/$(database)/documents/activeSessions/$(request.auth.uid)).data;
    }

    function workspaceExists(workspaceId) {
      return exists(/databases/$(database)/documents/workspaces/$(workspaceId));
    }

    function isWorkspaceActive(workspaceId) {
      return workspaceExists(workspaceId) &&
        get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.status == 'active';
    }

    function isWorkspaceMember(workspaceId) {
      return isSignedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function memberData(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data;
    }

    function memberRole(workspaceId) {
      return memberData(workspaceId).role;
    }

    function isWorkspaceHeadServant(workspaceId) {
      return isWorkspaceMember(workspaceId) && memberRole(workspaceId) == 'head_servant';
    }

    function isWorkspaceAdmin(workspaceId) {
      return isEnvironmentOwner() || (
        isWorkspaceMember(workspaceId) &&
        memberRole(workspaceId) in ['head_servant', 'assistant_head']
      );
    }

    function isWorkspaceServantOrAbove(workspaceId) {
      return isEnvironmentOwner() || (
        isWorkspaceMember(workspaceId) &&
        memberRole(workspaceId) in ['head_servant', 'assistant_head', 'servant']
      );
    }

    function matchesLoginDir(data, dirData) {
      return dirData.userId == data.userId &&
        dirData.role == data.role &&
        dirData.workspaceId == data.workspaceId &&
        dirData.linkedProfileId == data.linkedProfileId &&
        dirData.status in ['active', 'approved', 'pending'] &&
        hashing.sha256(data.claimProof.toUtf8()).toHexString().lower() == dirData.claimVerifier;
    }

    function hasValidLoginClaim(data, expectedUid) {
      return data.uid == expectedUid &&
        'loginKey' in data && isValidLoginKey(data.loginKey) &&
        'claimProof' in data && data.claimProof is string && data.claimProof.size() == 64 &&
        existsAfter(/databases/$(database)/documents/loginDirectory/$(data.loginKey)) &&
        matchesLoginDir(
          data,
          getAfter(/databases/$(database)/documents/loginDirectory/$(data.loginKey)).data
        );
    }

    function matchesWorkspaceDir(data, dirData, workspaceId) {
      return dirData.userId == data.userId &&
        dirData.role == data.role &&
        dirData.workspaceId == workspaceId &&
        dirData.linkedProfileId == data.linkedProfileId &&
        dirData.status in ['active', 'approved'] &&
        hashing.sha256(data.claimProof.toUtf8()).toHexString().lower() == dirData.claimVerifier;
    }

    function hasValidWorkspaceLoginClaim(data, expectedUid, workspaceId) {
      return data.uid == expectedUid &&
        'userId' in data && data.userId is string && data.userId.size() >= 2 && data.userId.size() <= 128 &&
        'loginKey' in data && isValidLoginKey(data.loginKey) &&
        'claimProof' in data && data.claimProof is string && data.claimProof.size() == 64 &&
        'linkedProfileId' in data && data.linkedProfileId is string && data.linkedProfileId.size() <= 128 &&
        existsAfter(/databases/$(database)/documents/loginDirectory/$(data.loginKey)) &&
        matchesWorkspaceDir(
          data,
          getAfter(/databases/$(database)/documents/loginDirectory/$(data.loginKey)).data,
          workspaceId
        );
    }

    // --- Entity Validation Blueprints ---
    function isValidLoginDirectory(data, loginKey) {
      return data.keys().hasAll([
          'loginKey', 'userId', 'username', 'role', 'workspaceId',
          'fullName', 'status', 'mustChangePassword', 'linkedProfileId',
          'salt', 'passwordHash', 'claimVerifier', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'loginKey', 'userId', 'username', 'role', 'workspaceId',
          'fullName', 'status', 'mustChangePassword', 'linkedProfileId',
          'salt', 'passwordHash', 'claimVerifier', 'phoneProofVerifier',
          'lastResetProof', 'createdAt', 'updatedAt'
        ]) &&
        data.loginKey == loginKey &&
        isValidLoginKey(data.loginKey) &&
        isValidId(data.userId) &&
        data.username is string && data.username.size() >= 2 && data.username.size() <= 64 &&
        data.role in ['applicant', 'head_servant', 'assistant_head', 'servant', 'student'] &&
        data.workspaceId is string && data.workspaceId.size() <= 128 &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120 &&
        data.status in ['active', 'pending', 'approved', 'rejected', 'suspended'] &&
        data.mustChangePassword is bool &&
        data.linkedProfileId is string && data.linkedProfileId.size() <= 128 &&
        data.salt is string && data.salt.size() >= 16 && data.salt.size() <= 64 &&
        data.passwordHash is string && data.passwordHash.size() >= 64 && data.passwordHash.size() <= 128 &&
        data.claimVerifier is string && data.claimVerifier.size() >= 64 && data.claimVerifier.size() <= 128 &&
        (!('phoneProofVerifier' in data) || (data.phoneProofVerifier is string && data.phoneProofVerifier.size() <= 128)) &&
        (!('lastResetProof' in data) || (data.lastResetProof is string && data.lastResetProof.size() <= 128)) &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidActiveSession(data, uid) {
      return data.keys().hasAll([
          'uid', 'userId', 'loginKey', 'role', 'workspaceId',
          'fullName', 'linkedProfileId', 'claimProof', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'userId', 'loginKey', 'role', 'workspaceId',
          'fullName', 'linkedProfileId', 'claimProof', 'createdAt', 'updatedAt'
        ]) &&
        data.uid == uid &&
        isValidId(data.uid) &&
        isValidId(data.userId) &&
        isValidLoginKey(data.loginKey) &&
        data.role in ['applicant', 'head_servant', 'assistant_head', 'servant', 'student'] &&
        data.workspaceId is string && data.workspaceId.size() <= 128 &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120 &&
        data.linkedProfileId is string && data.linkedProfileId.size() <= 128 &&
        data.claimProof is string && data.claimProof.size() == 64 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidWorkspace(data) {
      return data.keys().hasAll(['id', 'churchName', 'className', 'status', 'ownerUid', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'churchName', 'className', 'stageConfig', 'grades', 'stages', 'logoUrl',
          'verse', 'status', 'headServantId', 'headServantName', 'ownerUid',
          'studentCount', 'servantCount', 'customGroupIds', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.churchName is string && data.churchName.size() >= 2 && data.churchName.size() <= 120 &&
        data.className is string && data.className.size() >= 2 && data.className.size() <= 120 &&
        data.status in ['active', 'suspended'] &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('stageConfig' in data) || (data.stageConfig is string && data.stageConfig.size() <= 200)) &&
        (!('grades' in data) || (data.grades is list && data.grades.size() <= 15 && (data.grades.size() == 0 || data.grades[0] is string))) &&
        (!('stages' in data) || (data.stages is list && data.stages.size() <= 15 && (data.stages.size() == 0 || data.stages[0] is map))) &&
        (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 250000)) &&
        (!('verse' in data) || (data.verse is string && data.verse.size() <= 300)) &&
        (!('headServantId' in data) || (data.headServantId is string && data.headServantId.size() <= 128)) &&
        (!('headServantName' in data) || (data.headServantName is string && data.headServantName.size() <= 120)) &&
        (!('studentCount' in data) || (data.studentCount is number && data.studentCount >= 0)) &&
        (!('servantCount' in data) || (data.servantCount is number && data.servantCount >= 0)) &&
        (!('customGroupIds' in data) || (data.customGroupIds is list && data.customGroupIds.size() <= 100 && (data.customGroupIds.size() == 0 || data.customGroupIds[0] is string))) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidMember(data, workspaceId) {
      return data.keys().hasAll(['uid', 'workspaceId', 'role', 'createdAt']) &&
        data.keys().hasOnly([
          'uid', 'workspaceId', 'role', 'linkedProfileId',
          'userId', 'loginKey', 'claimProof', 'createdAt'
        ]) &&
        isValidId(data.uid) &&
        data.workspaceId == workspaceId &&
        data.role in ['head_servant', 'assistant_head', 'servant', 'student'] &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('linkedProfileId' in data) || (data.linkedProfileId is string && data.linkedProfileId.size() <= 128)) &&
        (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
        (!('loginKey' in data) || isValidLoginKey(data.loginKey)) &&
        (!('claimProof' in data) || (data.claimProof is string && data.claimProof.size() <= 128));
    }

    function isValidWorkspaceAccount(data, workspaceId) {
      return data.keys().hasAll([
          'id', 'workspaceId', 'username', 'role', 'fullName',
          'linkedProfileId', 'mustChangePassword', 'isActive', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'workspaceId', 'username', 'role', 'fullName', 'phone',
          'linkedProfileId', 'mustChangePassword', 'isActive', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.workspaceId == workspaceId &&
        data.username is string && data.username.size() >= 2 && data.username.size() <= 64 &&
        data.role in ['head_servant', 'assistant_head', 'servant', 'student'] &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120 &&
        data.linkedProfileId is string && data.linkedProfileId.size() <= 128 &&
        data.mustChangePassword is bool &&
        data.isActive is bool &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 32)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidGlobalUser(data) {
      return data.keys().hasAll(['id', 'username', 'role', 'fullName', 'status', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'username', 'role', 'workspaceId', 'fullName', 'status',
          'mustChangePassword', 'linkedProfileId',
          'ownerUid', 'approvedWorkspaceId', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.username is string && data.username.size() >= 2 && data.username.size() <= 64 &&
        data.role in ['environment_owner', 'applicant', 'head_servant', 'assistant_head', 'servant', 'student'] &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120 &&
        data.status in ['active', 'pending', 'approved', 'rejected', 'suspended'] &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('workspaceId' in data) || (data.workspaceId is string && data.workspaceId.size() <= 128)) &&
        (!('mustChangePassword' in data) || data.mustChangePassword is bool) &&
        (!('linkedProfileId' in data) || (data.linkedProfileId is string && data.linkedProfileId.size() <= 128)) &&
        (!('ownerUid' in data) || (data.ownerUid is string && data.ownerUid.size() <= 128)) &&
        (!('approvedWorkspaceId' in data) || (data.approvedWorkspaceId is string && data.approvedWorkspaceId.size() <= 128)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidGlobalUserPrivate(data, userId) {
      return data.keys().hasAll(['userId']) &&
        data.keys().hasOnly([
          'userId', 'phone', 'email', 'passwordHash', 'salt',
          'proposedChurchName', 'proposedClassName', 'proposedStageConfig',
          'serviceVision', 'mustChangePassword', 'linkedProfileId'
        ]) &&
        data.userId == userId &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 32)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
        (!('passwordHash' in data) || (data.passwordHash is string && data.passwordHash.size() <= 128)) &&
        (!('salt' in data) || (data.salt is string && data.salt.size() <= 64)) &&
        (!('proposedChurchName' in data) || (data.proposedChurchName is string && data.proposedChurchName.size() <= 120)) &&
        (!('proposedClassName' in data) || (data.proposedClassName is string && data.proposedClassName.size() <= 120)) &&
        (!('proposedStageConfig' in data) || (data.proposedStageConfig is string && data.proposedStageConfig.size() <= 200)) &&
        (!('serviceVision' in data) || (data.serviceVision is string && data.serviceVision.size() <= 1500)) &&
        (!('mustChangePassword' in data) || (data.mustChangePassword is bool)) &&
        (!('linkedProfileId' in data) || (data.linkedProfileId is string && data.linkedProfileId.size() <= 128));
    }

    function isValidChatChannel(data) {
      return data.keys().hasAll(['id', 'type', 'title']) &&
        data.keys().hasOnly([
          'id', 'type', 'title', 'isBroadcast', 'isCustomGroup', 'memberIds', 'memberUids',
          'createdBy', 'createdAt', 'participantUid', 'participantUserId',
          'participantName', 'participantRole', 'workspaceId',
          'churchName', 'className', 'lastMessage', 'lastMessageAt'
        ]) &&
        isValidId(data.id) &&
        data.type in ['group', 'direct', 'workspace_internal', 'applicant_direct'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        (!('isBroadcast' in data) || (data.isBroadcast is bool)) &&
        (!('isCustomGroup' in data) || (data.isCustomGroup is bool)) &&
        (!('memberIds' in data) || (data.memberIds is list && data.memberIds.size() <= 100 && (data.memberIds.size() == 0 || data.memberIds[0] is string))) &&
        (!('memberUids' in data) || (data.memberUids is list && data.memberUids.size() <= 100 && (data.memberUids.size() == 0 || data.memberUids[0] is string))) &&
        (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 128)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('participantUid' in data) || (data.participantUid is string && data.participantUid.size() <= 128)) &&
        (!('participantUserId' in data) || (data.participantUserId is string && data.participantUserId.size() <= 128)) &&
        (!('participantName' in data) || (data.participantName is string && data.participantName.size() <= 120)) &&
        (!('participantRole' in data) || (data.participantRole is string && data.participantRole.size() <= 40)) &&
        (!('workspaceId' in data) || (data.workspaceId is string && data.workspaceId.size() <= 128)) &&
        (!('churchName' in data) || (data.churchName is string && data.churchName.size() <= 120)) &&
        (!('className' in data) || (data.className is string && data.className.size() <= 120)) &&
        (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() <= 500)) &&
        (!('lastMessageAt' in data) || (data.lastMessageAt is string && data.lastMessageAt.size() <= 64));
    }

    function isValidChatMessage(data, channelId) {
      return data.keys().hasAll(['id', 'channelId', 'senderUid', 'senderName', 'text', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'channelId', 'senderUid', 'senderId', 'senderName',
          'senderRole', 'senderWorkspaceName', 'text', 'createdAt', 'isSystem'
        ]) &&
        isValidId(data.id) &&
        data.channelId == channelId &&
        data.senderUid == request.auth.uid &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 120 &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 2000 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('senderId' in data) || (data.senderId is string && data.senderId.size() <= 128)) &&
        (!('senderRole' in data) || (data.senderRole is string && data.senderRole.size() <= 40)) &&
        (!('senderWorkspaceName' in data) || (data.senderWorkspaceName is string && data.senderWorkspaceName.size() <= 140)) &&
        (!('isSystem' in data) || (data.isSystem is bool));
    }

    function isValidStudent(data, workspaceId) {
      return data.keys().hasAll(['id', 'workspaceId', 'fullName', 'grade', 'points', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'workspaceId', 'fullName', 'grade', 'gender', 'birthDate',
          'phone', 'parentPhone', 'address', 'avatarUrl', 'points', 'badges',
          'evaluations', 'attendanceHistory', 'pointsHistory', 'username',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.workspaceId == workspaceId &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120 &&
        data.grade is string && data.grade.size() >= 1 && data.grade.size() <= 80 &&
        data.points is number &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('gender' in data) || data.gender in ['ذكر', 'أنثى']) &&
        (!('birthDate' in data) || (data.birthDate is string && data.birthDate.size() <= 20)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 32)) &&
        (!('parentPhone' in data) || (data.parentPhone is string && data.parentPhone.size() <= 32)) &&
        (!('address' in data) || (data.address is string && data.address.size() <= 240)) &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 250000)) &&
        (!('badges' in data) || (data.badges is list && data.badges.size() <= 20 && (data.badges.size() == 0 || data.badges[0] is string))) &&
        (!('evaluations' in data) || data.evaluations is map) &&
        (!('attendanceHistory' in data) || (data.attendanceHistory is list && data.attendanceHistory.size() <= 1000)) &&
        (!('pointsHistory' in data) || (data.pointsHistory is list && data.pointsHistory.size() <= 1000)) &&
        (!('username' in data) || (data.username is string && data.username.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidServant(data, workspaceId) {
      return data.keys().hasAll(['id', 'workspaceId', 'fullName', 'role', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'workspaceId', 'fullName', 'role', 'phone', 'assignedGrade',
          'gender', 'avatarUrl', 'username', 'bio', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.workspaceId == workspaceId &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120 &&
        data.role in ['head_servant', 'assistant_head', 'servant'] &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 32)) &&
        (!('assignedGrade' in data) || (data.assignedGrade is string && data.assignedGrade.size() <= 80)) &&
        (!('gender' in data) || data.gender in ['ذكر', 'أنثى']) &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 250000)) &&
        (!('username' in data) || (data.username is string && data.username.size() <= 64)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidMonthlySchedule(data, workspaceId) {
      return data.keys().hasAll(['id', 'workspaceId', 'date', 'grade', 'lessonTitle', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'workspaceId', 'date', 'dateLabel', 'grade', 'lessonTitle', 'memoryVerse',
          'primaryTeacherId', 'primaryTeacherName', 'backupTeacherId',
          'backupTeacherName', 'stageLessons', 'segments', 'segmentDetails',
          'notes', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.workspaceId == workspaceId &&
        data.date is string && data.date.size() <= 20 &&
        data.grade is string && data.grade.size() <= 80 &&
        data.lessonTitle is string && data.lessonTitle.size() <= 200 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('dateLabel' in data) || (data.dateLabel is string && data.dateLabel.size() <= 120)) &&
        (!('memoryVerse' in data) || (data.memoryVerse is string && data.memoryVerse.size() <= 300)) &&
        (!('primaryTeacherId' in data) || (data.primaryTeacherId is string && data.primaryTeacherId.size() <= 128)) &&
        (!('primaryTeacherName' in data) || (data.primaryTeacherName is string && data.primaryTeacherName.size() <= 120)) &&
        (!('backupTeacherId' in data) || (data.backupTeacherId is string && data.backupTeacherId.size() <= 128)) &&
        (!('backupTeacherName' in data) || (data.backupTeacherName is string && data.backupTeacherName.size() <= 120)) &&
        (!('stageLessons' in data) || (data.stageLessons is list && data.stageLessons.size() <= 15 && (data.stageLessons.size() == 0 || data.stageLessons[0] is map))) &&
        (!('segments' in data) || data.segments is map) &&
        (!('segmentDetails' in data) || data.segmentDetails is map) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidVisitation(data, workspaceId) {
      return data.keys().hasAll(['id', 'workspaceId', 'studentId', 'servantId', 'status']) &&
        data.keys().hasOnly([
          'id', 'workspaceId', 'studentId', 'studentName', 'studentGrade',
          'studentPhone', 'parentPhone', 'servantId', 'servantName',
          'status', 'weekLabel', 'notes', 'lastUpdatedAt'
        ]) &&
        isValidId(data.id) &&
        data.workspaceId == workspaceId &&
        data.studentId is string && data.studentId.size() <= 128 &&
        data.servantId is string && data.servantId.size() <= 128 &&
        data.status in ['pending', 'called', 'visited', 'no_answer', 'special_care'] &&
        (!('studentName' in data) || (data.studentName is string && data.studentName.size() <= 120)) &&
        (!('studentGrade' in data) || (data.studentGrade is string && data.studentGrade.size() <= 80)) &&
        (!('studentPhone' in data) || (data.studentPhone is string && data.studentPhone.size() <= 32)) &&
        (!('parentPhone' in data) || (data.parentPhone is string && data.parentPhone.size() <= 32)) &&
        (!('servantName' in data) || (data.servantName is string && data.servantName.size() <= 120)) &&
        (!('weekLabel' in data) || (data.weekLabel is string && data.weekLabel.size() <= 64)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
        (!('lastUpdatedAt' in data) || (data.lastUpdatedAt is string && data.lastUpdatedAt.size() <= 64));
    }

    function isValidAnnouncement(data, workspaceId) {
      return data.keys().hasAll(['id', 'workspaceId', 'title', 'body', 'target', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'workspaceId', 'title', 'body', 'target', 'isUrgent',
          'authorName', 'authorRole', 'createdAt'
        ]) &&
        isValidId(data.id) &&
        data.workspaceId == workspaceId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.body is string && data.body.size() >= 1 && data.body.size() <= 2000 &&
        data.target in ['all', 'students_only', 'servants_only'] &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('isUrgent' in data) || data.isUrgent is bool) &&
        (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 120)) &&
        (!('authorRole' in data) || (data.authorRole is string && data.authorRole.size() <= 40));
    }

    function isValidChangeRequest(data, workspaceId) {
      return data.keys().hasAll(['id', 'workspaceId', 'studentId', 'field', 'newValue', 'status', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'workspaceId', 'studentId', 'studentName', 'ownerUid',
          'requestedByUsername', 'field', 'oldValue', 'newValue', 'reason',
          'status', 'reviewedBy', 'reviewedAt', 'createdAt'
        ]) &&
        isValidId(data.id) &&
        data.workspaceId == workspaceId &&
        data.studentId is string && data.studentId.size() <= 128 &&
        data.field is string && data.field.size() <= 64 &&
        data.newValue is string && data.newValue.size() <= 300 &&
        data.status in ['pending', 'approved', 'rejected'] &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('studentName' in data) || (data.studentName is string && data.studentName.size() <= 120)) &&
        (!('ownerUid' in data) || (data.ownerUid is string && data.ownerUid.size() <= 128)) &&
        (!('requestedByUsername' in data) || (data.requestedByUsername is string && data.requestedByUsername.size() <= 64)) &&
        (!('oldValue' in data) || (data.oldValue is string && data.oldValue.size() <= 300)) &&
        (!('reason' in data) || (data.reason is string && data.reason.size() <= 400)) &&
        (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 120)) &&
        (!('reviewedAt' in data) || (data.reviewedAt is string && data.reviewedAt.size() <= 64));
    }

    function isValidServantLog(data, workspaceId) {
      return data.keys().hasAll(['id', 'workspaceId', 'servantId', 'action', 'createdAt']) &&
        data.keys().hasOnly(['id', 'workspaceId', 'servantId', 'servantName', 'action', 'details', 'createdAt']) &&
        isValidId(data.id) &&
        data.workspaceId == workspaceId &&
        data.servantId is string && data.servantId.size() <= 128 &&
        data.action is string && data.action.size() <= 120 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('servantName' in data) || (data.servantName is string && data.servantName.size() <= 120)) &&
        (!('details' in data) || (data.details is string && data.details.size() <= 500));
    }

    function isChannelReader(channelId, chData) {
      return isEnvironmentOwner() ||
        (channelId == 'global_leaders' && hasActiveSession() && (
          activeSessionData().role == 'head_servant' ||
          (exists(/databases/$(database)/documents/globalUsers/$(activeSessionData().userId)) &&
           get(/databases/$(database)/documents/globalUsers/$(activeSessionData().userId)).data.role == 'head_servant')
        )) ||
        (('isBroadcast' in chData) && chData.isBroadcast == true && hasActiveSession() && activeSessionData().role == 'head_servant') ||
        (('participantUid' in chData) && chData.participantUid == request.auth.uid) ||
        (('participantUserId' in chData) && hasActiveSession() && activeSessionData().userId == chData.participantUserId) ||
        (chData.type == 'group' && ('memberIds' in chData) && hasActiveSession() && activeSessionData().userId in chData.memberIds) ||
        (chData.type == 'workspace_internal' && ('workspaceId' in chData) && chData.workspaceId is string && isWorkspaceServantOrAbove(chData.workspaceId));
    }

    function isChannelWriter(channelId, chData) {
      return isEnvironmentOwner() || (
        channelId != 'global_leaders' &&
        (!('isBroadcast' in chData) || chData.isBroadcast == false) &&
        (
          (('participantUid' in chData) && chData.participantUid == request.auth.uid) ||
          (('participantUserId' in chData) && hasActiveSession() && activeSessionData().userId == chData.participantUserId) ||
          (chData.type == 'group' && ('memberIds' in chData) && hasActiveSession() && activeSessionData().userId in chData.memberIds) ||
          (chData.type == 'workspace_internal' && ('workspaceId' in chData) && chData.workspaceId is string && isWorkspaceActive(chData.workspaceId) && isWorkspaceServantOrAbove(chData.workspaceId))
        )
      );
    }

    // --- Test Connection Health Check ---
    match /test/{docId} {
      allow get: if isSignedIn() && docId == 'connection';
    }

    // --- Case-Sensitive Login Directory (No PII, No List Enumeration) ---
    match /loginDirectory/{loginKey} {
      allow get: if isSignedIn() && isValidLoginKey(loginKey);
      allow list: if false;
      allow create: if isSignedIn() && isValidLoginKey(loginKey) && isValidLoginDirectory(incoming(), loginKey) && (
        isEnvironmentOwner() ||
        (
          incoming().workspaceId != '' &&
          existsAfter(/databases/$(database)/documents/workspaces/$(incoming().workspaceId)) &&
          (
            (isWorkspaceHeadServant(incoming().workspaceId) && incoming().role in ['head_servant', 'assistant_head', 'servant', 'student']) ||
            (isWorkspaceAdmin(incoming().workspaceId) && incoming().role in ['assistant_head', 'servant', 'student']) ||
            (isWorkspaceServantOrAbove(incoming().workspaceId) && incoming().role == 'student')
          )
        ) ||
        (
          incoming().role == 'applicant' &&
          incoming().status == 'pending' &&
          incoming().workspaceId == '' &&
          incoming().userId == request.auth.uid &&
          incoming().linkedProfileId == request.auth.uid
        )
      );
      allow update: if isSignedIn() && isValidLoginKey(loginKey) && isValidLoginDirectory(incoming(), loginKey) && (
        isEnvironmentOwner() ||
        (
          existing().workspaceId != '' &&
          isWorkspaceAdmin(existing().workspaceId) &&
          (existing().role != 'head_servant' || isWorkspaceHeadServant(existing().workspaceId)) &&
          incoming().workspaceId == existing().workspaceId &&
          incoming().userId == existing().userId &&
          incoming().role in ['head_servant', 'assistant_head', 'servant', 'student'] &&
          incoming().createdAt == existing().createdAt
        ) ||
        (
          hasActiveSession() &&
          activeSessionData().userId == existing().userId &&
          incoming().userId == existing().userId &&
          incoming().username == existing().username &&
          incoming().role == existing().role &&
          incoming().workspaceId == existing().workspaceId &&
          incoming().status == existing().status &&
          incoming().linkedProfileId == existing().linkedProfileId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'salt', 'passwordHash', 'claimVerifier', 'mustChangePassword', 'updatedAt'
          ])
        ) ||
        (
          'phoneProofVerifier' in existing() &&
          existing().phoneProofVerifier is string &&
          existing().phoneProofVerifier.size() == 64 &&
          'lastResetProof' in incoming() &&
          incoming().lastResetProof is string &&
          incoming().lastResetProof.size() == 64 &&
          hashing.sha256(incoming().lastResetProof.toUtf8()).toHexString().lower() == existing().phoneProofVerifier &&
          incoming().userId == existing().userId &&
          incoming().username == existing().username &&
          incoming().role == existing().role &&
          incoming().workspaceId == existing().workspaceId &&
          incoming().status == existing().status &&
          incoming().linkedProfileId == existing().linkedProfileId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'salt', 'passwordHash', 'claimVerifier', 'phoneProofVerifier',
            'lastResetProof', 'mustChangePassword', 'updatedAt'
          ])
        )
      );
      allow delete: if isSignedIn() && isValidLoginKey(loginKey) && (
        isEnvironmentOwner() ||
        (
          existing().workspaceId != '' &&
          isWorkspaceAdmin(existing().workspaceId) &&
          (existing().role != 'head_servant' || isWorkspaceHeadServant(existing().workspaceId))
        )
      );
    }

    // --- Active Sessions (Multi-Device Identity Binding) ---
    match /activeSessions/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (request.auth.uid == uid || isEnvironmentOwner());
      allow list: if isEnvironmentOwner();
      allow create, update: if isSignedIn() && isValidId(uid) &&
        request.auth.uid == uid &&
        isValidActiveSession(incoming(), uid) &&
        hasValidLoginClaim(incoming(), uid);
      allow delete: if isSignedIn() && isValidId(uid) && (request.auth.uid == uid || isEnvironmentOwner());
    }

    // --- Global Users & Isolated Private PII ---
    match /globalUsers/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        request.auth.uid == userId ||
        isEnvironmentOwner() ||
        (hasActiveSession() && activeSessionData().userId == userId)
      );
      allow list: if isEnvironmentOwner() || (
        isSignedIn() && existing().ownerUid == request.auth.uid
      );
      allow create: if isSignedIn() && isValidId(userId) && isValidGlobalUser(incoming()) && (
        isEnvironmentOwner() ||
        (
          'workspaceId' in incoming() &&
          incoming().workspaceId != '' &&
          existsAfter(/databases/$(database)/documents/workspaces/$(incoming().workspaceId)) &&
          (
            (isWorkspaceAdmin(incoming().workspaceId) && incoming().role in ['assistant_head', 'servant', 'student']) ||
            (isWorkspaceServantOrAbove(incoming().workspaceId) && incoming().role == 'student')
          )
        ) ||
        (
          request.auth.uid == userId &&
          incoming().ownerUid == request.auth.uid &&
          incoming().role == 'applicant' &&
          incoming().status == 'pending'
        )
      );
      allow update: if isSignedIn() && isValidId(userId) && isValidGlobalUser(incoming()) && (
        isEnvironmentOwner() ||
        (
          'workspaceId' in existing() &&
          existing().workspaceId != '' &&
          isWorkspaceAdmin(existing().workspaceId) &&
          (existing().role != 'head_servant' || isWorkspaceHeadServant(existing().workspaceId)) &&
          incoming().workspaceId == existing().workspaceId &&
          incoming().role in ['head_servant', 'assistant_head', 'servant', 'student'] &&
          incoming().createdAt == existing().createdAt
        ) ||
        (
          (request.auth.uid == userId || (hasActiveSession() && activeSessionData().userId == userId)) &&
          incoming().id == existing().id &&
          incoming().role == existing().role &&
          incoming().status == existing().status &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'mustChangePassword', 'updatedAt'])
        )
      );
      allow delete: if isSignedIn() && isValidId(userId) && (
        isEnvironmentOwner() ||
        ('workspaceId' in existing() && existing().workspaceId != '' && isWorkspaceAdmin(existing().workspaceId))
      );

      match /private/{docId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(docId) && (
          request.auth.uid == userId ||
          isEnvironmentOwner() ||
          (hasActiveSession() && activeSessionData().userId == userId)
        );
        allow create: if isSignedIn() && isValidId(userId) && isValidId(docId) &&
          isValidGlobalUserPrivate(incoming(), userId) && (
            isEnvironmentOwner() ||
            request.auth.uid == userId ||
            (
              existsAfter(/databases/$(database)/documents/globalUsers/$(userId)) &&
              getAfter(/databases/$(database)/documents/globalUsers/$(userId)).data.workspaceId != '' &&
              isWorkspaceServantOrAbove(getAfter(/databases/$(database)/documents/globalUsers/$(userId)).data.workspaceId)
            )
          );
        allow update: if isSignedIn() && isValidId(userId) && isValidId(docId) &&
          isValidGlobalUserPrivate(incoming(), userId) && (
            isEnvironmentOwner() ||
            (
              exists(/databases/$(database)/documents/globalUsers/$(userId)) &&
              get(/databases/$(database)/documents/globalUsers/$(userId)).data.workspaceId != '' &&
              isWorkspaceAdmin(get(/databases/$(database)/documents/globalUsers/$(userId)).data.workspaceId)
            ) ||
            (
              (request.auth.uid == userId || (hasActiveSession() && activeSessionData().userId == userId)) &&
              incoming().userId == existing().userId &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'phone', 'passwordHash', 'salt', 'serviceVision', 'mustChangePassword'
              ])
            )
          );
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(docId) && (
          isEnvironmentOwner() ||
          (
            exists(/databases/$(database)/documents/globalUsers/$(userId)) &&
            get(/databases/$(database)/documents/globalUsers/$(userId)).data.workspaceId != '' &&
            isWorkspaceAdmin(get(/databases/$(database)/documents/globalUsers/$(userId)).data.workspaceId)
          )
        );
      }
    }

    // --- Environment Leadership & Onboarding Chat ---
    match /environmentChat/{channelId} {
      allow get: if isSignedIn() && isValidId(channelId) && isChannelReader(channelId, existing());
      allow list: if isEnvironmentOwner();
      allow create: if isSignedIn() && isValidId(channelId) && isValidChatChannel(incoming()) && (
        isEnvironmentOwner() ||
        (
          incoming().type in ['direct', 'applicant_direct'] &&
          (
            incoming().participantUid == request.auth.uid ||
            (hasActiveSession() && activeSessionData().userId == incoming().participantUserId)
          )
        ) ||
        (incoming().type == 'workspace_internal' && incoming().workspaceId is string && isWorkspaceServantOrAbove(incoming().workspaceId))
      );
      allow update: if isSignedIn() && isValidId(channelId) && isValidChatChannel(incoming()) && (
        isEnvironmentOwner() ||
        (
          isChannelWriter(channelId, existing()) &&
          incoming().id == existing().id &&
          incoming().type == existing().type &&
          incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt'])
        )
      );
      allow delete: if isEnvironmentOwner() && isValidId(channelId);

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(channelId) && isValidId(messageId) &&
          exists(/databases/$(database)/documents/environmentChat/$(channelId)) &&
          isChannelReader(channelId, get(/databases/$(database)/documents/environmentChat/$(channelId)).data);
        allow list: if isEnvironmentOwner() || (
          isSignedIn() &&
          exists(/databases/$(database)/documents/environmentChat/$(channelId)) &&
          isChannelReader(channelId, get(/databases/$(database)/documents/environmentChat/$(channelId)).data)
        );
        allow create: if isSignedIn() && isValidId(channelId) && isValidId(messageId) &&
          isValidChatMessage(incoming(), channelId) &&
          existsAfter(/databases/$(database)/documents/environmentChat/$(channelId)) &&
          isChannelWriter(channelId, getAfter(/databases/$(database)/documents/environmentChat/$(channelId)).data);
        allow update, delete: if isEnvironmentOwner() && isValidId(channelId) && isValidId(messageId);
      }
    }

    // --- Multi-Tenant Workspaces (Isolated Rooms/Classes) ---
    match /workspaces/{workspaceId} {
      allow get: if isSignedIn() && isValidId(workspaceId) && (
        isEnvironmentOwner() || isWorkspaceMember(workspaceId)
      );
      allow list: if isEnvironmentOwner() || (
        isSignedIn() && existing().ownerUid == request.auth.uid
      );
      allow create: if isEnvironmentOwner() && isValidId(workspaceId) && isValidWorkspace(incoming());
      allow update: if isSignedIn() && isValidId(workspaceId) && isValidWorkspace(incoming()) && (
        isEnvironmentOwner() ||
        (
          existing().status == 'active' &&
          isWorkspaceAdmin(workspaceId) &&
          incoming().id == existing().id &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().status == existing().status &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'churchName', 'className', 'stageConfig', 'grades', 'stages', 'logoUrl',
            'verse', 'studentCount', 'servantCount', 'updatedAt'
          ])
        ) ||
        (
          existing().status == 'active' &&
          isWorkspaceServantOrAbove(workspaceId) &&
          incoming().id == existing().id &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().status == existing().status &&
          incoming().diff(existing()).affectedKeys().hasOnly(['studentCount', 'updatedAt'])
        )
      );
      allow delete: if isEnvironmentOwner() && isValidId(workspaceId);

      // Workspace Members (Master Gate)
      match /members/{uid} {
        allow get: if isSignedIn() && isValidId(workspaceId) && isValidId(uid) && (
          isEnvironmentOwner() || request.auth.uid == uid || isWorkspaceAdmin(workspaceId)
        );
        allow list: if isEnvironmentOwner() || isWorkspaceAdmin(workspaceId) || (
          isSignedIn() && existing().workspaceId == workspaceId && existing().uid == request.auth.uid
        );
        allow create: if isSignedIn() && isValidId(workspaceId) && isValidId(uid) &&
          workspaceExists(workspaceId) && isValidMember(incoming(), workspaceId) && (
            isEnvironmentOwner() ||
            isWorkspaceAdmin(workspaceId) ||
            (request.auth.uid == uid && hasValidWorkspaceLoginClaim(incoming(), uid, workspaceId))
          );
        allow update: if isSignedIn() && isValidId(workspaceId) && isValidId(uid) &&
          isValidMember(incoming(), workspaceId) && (
            isEnvironmentOwner() ||
            (
              isWorkspaceAdmin(workspaceId) &&
              incoming().uid == existing().uid &&
              incoming().workspaceId == existing().workspaceId &&
              incoming().createdAt == existing().createdAt &&
              incoming().diff(existing()).affectedKeys().hasOnly(['role', 'linkedProfileId'])
            ) ||
            (
              request.auth.uid == uid &&
              workspaceExists(workspaceId) &&
              hasValidWorkspaceLoginClaim(incoming(), uid, workspaceId)
            )
          );
        allow delete: if isSignedIn() && isValidId(workspaceId) && isValidId(uid) && (
          isEnvironmentOwner() || request.auth.uid == uid || isWorkspaceAdmin(workspaceId)
        );
      }

      // Workspace Accounts Subcollection (Leadership Administration)
      match /accounts/{accountId} {
        allow get: if isSignedIn() && isValidId(workspaceId) && isValidId(accountId) && (
          isEnvironmentOwner() || isWorkspaceAdmin(workspaceId)
        );
        allow list: if isEnvironmentOwner() || (
          isSignedIn() && isWorkspaceAdmin(workspaceId) && existing().workspaceId == workspaceId
        );
        allow create: if isSignedIn() && isValidId(workspaceId) && isValidId(accountId) &&
          existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
          isValidWorkspaceAccount(incoming(), workspaceId) && (
            isEnvironmentOwner() ||
            isWorkspaceAdmin(workspaceId) ||
            (isWorkspaceServantOrAbove(workspaceId) && incoming().role == 'student')
          );
        allow update: if isSignedIn() && isValidId(workspaceId) && isValidId(accountId) &&
          isValidWorkspaceAccount(incoming(), workspaceId) && (
            isEnvironmentOwner() ||
            (
              isWorkspaceActive(workspaceId) &&
              isWorkspaceAdmin(workspaceId) &&
              (existing().role != 'head_servant' || isWorkspaceHeadServant(workspaceId)) &&
              incoming().id == existing().id &&
              incoming().workspaceId == existing().workspaceId &&
              incoming().createdAt == existing().createdAt &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'username', 'fullName', 'phone', 'role', 'mustChangePassword', 'isActive', 'updatedAt'
              ])
            ) ||
            (
              hasActiveSession() &&
              activeSessionData().workspaceId == workspaceId &&
              activeSessionData().linkedProfileId == existing().linkedProfileId &&
              incoming().id == existing().id &&
              incoming().workspaceId == existing().workspaceId &&
              incoming().role == existing().role &&
              incoming().linkedProfileId == existing().linkedProfileId &&
              incoming().createdAt == existing().createdAt &&
              incoming().diff(existing()).affectedKeys().hasOnly(['mustChangePassword', 'updatedAt'])
            )
          );
        allow delete: if isSignedIn() && isValidId(workspaceId) && isValidId(accountId) && (
          isEnvironmentOwner() || isWorkspaceAdmin(workspaceId)
        );
      }

      // Students Subcollection
      match /students/{studentId} {
        allow get: if isSignedIn() && isValidId(workspaceId) && isValidId(studentId) && (
          isEnvironmentOwner() ||
          isWorkspaceServantOrAbove(workspaceId) ||
          (isWorkspaceMember(workspaceId) && memberData(workspaceId).linkedProfileId == studentId)
        );
        allow list: if isEnvironmentOwner() || (
          isSignedIn() && isWorkspaceServantOrAbove(workspaceId) && existing().workspaceId == workspaceId
        );
        allow create: if isSignedIn() && isValidId(workspaceId) && isValidId(studentId) &&
          isValidStudent(incoming(), workspaceId) &&
          (isEnvironmentOwner() || (isWorkspaceActive(workspaceId) && isWorkspaceServantOrAbove(workspaceId)));
        allow update: if isSignedIn() && isValidId(workspaceId) && isValidId(studentId) &&
          isValidStudent(incoming(), workspaceId) && (
            isEnvironmentOwner() ||
            (
              isWorkspaceActive(workspaceId) &&
              isWorkspaceServantOrAbove(workspaceId) &&
              incoming().id == existing().id &&
              incoming().workspaceId == existing().workspaceId &&
              incoming().createdAt == existing().createdAt &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'fullName', 'grade', 'gender', 'birthDate', 'phone', 'parentPhone',
                'address', 'avatarUrl', 'points', 'badges', 'evaluations',
                'attendanceHistory', 'pointsHistory', 'username', 'updatedAt'
              ])
            )
          );
        allow delete: if isSignedIn() && isValidId(workspaceId) && isValidId(studentId) &&
          (isEnvironmentOwner() || (isWorkspaceActive(workspaceId) && isWorkspaceAdmin(workspaceId)));
      }

      // Servants Subcollection
      match /servants/{servantId} {
        allow get: if isSignedIn() && isValidId(workspaceId) && isValidId(servantId) && (
          isEnvironmentOwner() || isWorkspaceMember(workspaceId)
        );
        allow list: if isEnvironmentOwner() || (
          isSignedIn() && isWorkspaceMember(workspaceId) && existing().workspaceId == workspaceId
        );
        allow create: if isSignedIn() && isValidId(workspaceId) && isValidId(servantId) &&
          existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
          isValidServant(incoming(), workspaceId) &&
          isWorkspaceAdmin(workspaceId);
        allow update: if isSignedIn() && isValidId(workspaceId) && isValidId(servantId) &&
          isValidServant(incoming(), workspaceId) && (
            isEnvironmentOwner() ||
            (
              isWorkspaceAdmin(workspaceId) &&
              incoming().id == existing().id &&
              incoming().workspaceId == existing().workspaceId &&
              incoming().createdAt == existing().createdAt &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'fullName', 'role', 'phone', 'assignedGrade', 'gender',
                'avatarUrl', 'username', 'bio', 'updatedAt'
              ])
            ) ||
            (
              isWorkspaceServantOrAbove(workspaceId) &&
              incoming().id == existing().id &&
              incoming().workspaceId == existing().workspaceId &&
              incoming().role == existing().role &&
              incoming().createdAt == existing().createdAt &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'fullName', 'phone', 'avatarUrl', 'bio', 'updatedAt'
              ])
            )
          );
        allow delete: if isSignedIn() && isValidId(workspaceId) && isValidId(servantId) && isWorkspaceAdmin(workspaceId);
      }

      // Monthly Schedules Subcollection
      match /monthlySchedules/{scheduleId} {
        allow get: if isSignedIn() && isValidId(workspaceId) && isValidId(scheduleId) && (
          isEnvironmentOwner() || isWorkspaceMember(workspaceId)
        );
        allow list: if isEnvironmentOwner() || (
          isSignedIn() && isWorkspaceMember(workspaceId) && existing().workspaceId == workspaceId
        );
        allow create: if isSignedIn() && isValidId(workspaceId) && isValidId(scheduleId) &&
          workspaceExists(workspaceId) && isValidMonthlySchedule(incoming(), workspaceId) &&
          isWorkspaceServantOrAbove(workspaceId);
        allow update: if isSignedIn() && isValidId(workspaceId) && isValidId(scheduleId) &&
          isValidMonthlySchedule(incoming(), workspaceId) && (
            isEnvironmentOwner() ||
            (
              isWorkspaceServantOrAbove(workspaceId) &&
              incoming().id == existing().id &&
              incoming().workspaceId == existing().workspaceId &&
              incoming().createdAt == existing().createdAt &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'date', 'dateLabel', 'grade', 'lessonTitle', 'memoryVerse',
                'primaryTeacherId', 'primaryTeacherName',
                'backupTeacherId', 'backupTeacherName',
                'stageLessons', 'segments', 'segmentDetails', 'notes', 'updatedAt'
              ])
            )
          );
        allow delete: if isSignedIn() && isValidId(workspaceId) && isValidId(scheduleId) && isWorkspaceAdmin(workspaceId);
      }

      // Visitation Schedules Subcollection
      match /visitationSchedules/{visitId} {
        allow get: if isSignedIn() && isValidId(workspaceId) && isValidId(visitId) && (
          isEnvironmentOwner() || isWorkspaceServantOrAbove(workspaceId)
        );
        allow list: if isEnvironmentOwner() || (
          isSignedIn() && isWorkspaceServantOrAbove(workspaceId) && existing().workspaceId == workspaceId
        );
        allow create: if isSignedIn() && isValidId(workspaceId) && isValidId(visitId) &&
          workspaceExists(workspaceId) && isValidVisitation(incoming(), workspaceId) &&
          isWorkspaceServantOrAbove(workspaceId);
        allow update: if isSignedIn() && isValidId(workspaceId) && isValidId(visitId) &&
          isValidVisitation(incoming(), workspaceId) && (
            isEnvironmentOwner() ||
            (
              isWorkspaceServantOrAbove(workspaceId) &&
              incoming().id == existing().id &&
              incoming().workspaceId == existing().workspaceId &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'servantId', 'servantName', 'status', 'weekLabel', 'notes', 'lastUpdatedAt'
              ])
            )
          );
        allow delete: if isSignedIn() && isValidId(workspaceId) && isValidId(visitId) && isWorkspaceAdmin(workspaceId);
      }

      // Announcements Subcollection
      match /announcements/{announcementId} {
        allow get: if isSignedIn() && isValidId(workspaceId) && isValidId(announcementId) && (
          isEnvironmentOwner() ||
          isWorkspaceServantOrAbove(workspaceId) ||
          (isWorkspaceMember(workspaceId) && existing().target in ['all', 'students_only'])
        );
        allow list: if isEnvironmentOwner() || (
          isSignedIn() &&
          isWorkspaceMember(workspaceId) &&
          existing().workspaceId == workspaceId &&
          (existing().target in ['all', 'students_only'] || isWorkspaceServantOrAbove(workspaceId))
        );
        allow create: if isSignedIn() && isValidId(workspaceId) && isValidId(announcementId) &&
          workspaceExists(workspaceId) && isValidAnnouncement(incoming(), workspaceId) &&
          isWorkspaceServantOrAbove(workspaceId);
        allow update: if isSignedIn() && isValidId(workspaceId) && isValidId(announcementId) &&
          isValidAnnouncement(incoming(), workspaceId) && (
            isEnvironmentOwner() ||
            (
              isWorkspaceAdmin(workspaceId) &&
              incoming().id == existing().id &&
              incoming().workspaceId == existing().workspaceId &&
              incoming().createdAt == existing().createdAt &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'title', 'body', 'target', 'isUrgent'
              ])
            )
          );
        allow delete: if isSignedIn() && isValidId(workspaceId) && isValidId(announcementId) && isWorkspaceAdmin(workspaceId);
      }

      // Change Requests Subcollection
      match /changeRequests/{requestId} {
        allow get: if isSignedIn() && isValidId(workspaceId) && isValidId(requestId) && (
          isEnvironmentOwner() ||
          isWorkspaceServantOrAbove(workspaceId) ||
          existing().ownerUid == request.auth.uid ||
          (isWorkspaceMember(workspaceId) && memberData(workspaceId).linkedProfileId == existing().studentId)
        );
        allow list: if isEnvironmentOwner() || isWorkspaceServantOrAbove(workspaceId) || (
          isSignedIn() && isWorkspaceMember(workspaceId) && existing().workspaceId == workspaceId && (
            existing().ownerUid == request.auth.uid ||
            existing().studentId == memberData(workspaceId).linkedProfileId
          )
        );
        allow create: if isSignedIn() && isValidId(workspaceId) && isValidId(requestId) &&
          workspaceExists(workspaceId) && isValidChangeRequest(incoming(), workspaceId) &&
          isWorkspaceMember(workspaceId) &&
          incoming().ownerUid == request.auth.uid &&
          incoming().status == 'pending';
        allow update: if isSignedIn() && isValidId(workspaceId) && isValidId(requestId) &&
          isValidChangeRequest(incoming(), workspaceId) && (
            isEnvironmentOwner() ||
            (
              isWorkspaceAdmin(workspaceId) &&
              existing().status == 'pending' &&
              incoming().id == existing().id &&
              incoming().workspaceId == existing().workspaceId &&
              incoming().createdAt == existing().createdAt &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt'])
            )
          );
        allow delete: if isSignedIn() && isValidId(workspaceId) && isValidId(requestId) && isWorkspaceAdmin(workspaceId);
      }

      // Servant Audit Logs Subcollection
      match /servantLogs/{logId} {
        allow get: if isSignedIn() && isValidId(workspaceId) && isValidId(logId) && (
          isEnvironmentOwner() || isWorkspaceAdmin(workspaceId)
        );
        allow list: if isEnvironmentOwner() || (isSignedIn() && isWorkspaceAdmin(workspaceId));
        allow create: if isSignedIn() && isValidId(workspaceId) && isValidId(logId) &&
          workspaceExists(workspaceId) && isValidServantLog(incoming(), workspaceId) &&
          isWorkspaceServantOrAbove(workspaceId);
        allow update, delete: if isEnvironmentOwner();
      }
    }
  }
}
